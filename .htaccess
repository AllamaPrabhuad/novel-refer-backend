# Novel Tissues — Hostinger settings (generated by npm run build:hostinger)
Options -Indexes
DirectoryIndex index.html index.php

RewriteEngine On
# Always use HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# One main address (www.noveltissues.com) so Google sees a single version of every page
RewriteCond %{HTTP_HOST} ^noveltissues\.com$ [NC]
RewriteRule ^ https://www.noveltissues.com%{REQUEST_URI} [L,R=301]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>
